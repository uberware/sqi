root = true

# ─── Defaults ─────────────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# ─── Go ───────────────────────────────────────────────────────────────────────
[*.go]
indent_style = tab
indent_size = 4

# ─── TypeScript / JavaScript ──────────────────────────────────────────────────
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

# ─── Web / Config ─────────────────────────────────────────────────────────────
[*.{json,yaml,yml,toml,html,css,scss}]
indent_style = space
indent_size = 2

# ─── Markdown ─────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# ─── Makefiles ────────────────────────────────────────────────────────────────
[Makefile]
indent_style = tab

# ─── Shell ────────────────────────────────────────────────────────────────────
[*.sh]
indent_style = space
indent_size = 2
