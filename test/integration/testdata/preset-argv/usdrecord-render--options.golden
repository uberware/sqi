preset: usdrecord-render
case:   options
params:
  Camera=/World/cam
  Frames=1
  FramesPerTask=10
  ImageWidth=1920
  OutputFile=/mnt/show/seq010/shot0010/review/shot0010.####.png
  Renderer=Karma CPU
  SceneFile=/mnt/show/seq010/shot0010/usd/shot0010_layout.usd

step "Render" — 1 task

task 1/1  name="Render[Frame=1-1]"
  task params:
    Frame=1-1
  command: hython
  args:
    [0]  <WORKDIR>
    [1]  --renderer
    [2]  Karma CPU
    [3]  --camera
    [4]  /World/cam
    [5]  --imageWidth
    [6]  1920
    [7]  --frames
    [8]  1:1
    [9]  /mnt/show/seq010/shot0010/usd/shot0010_layout.usd
    [10]  /mnt/show/seq010/shot0010/review/shot0010.####.png
  embedded file "launcher" (launcher.py):
    import os, runpy, sys
    script = os.path.join(os.environ["HFS"], "bin", "usdrecord")
    # usdrecord does not create the output folder; the last argument
    # is the output pattern.
    folder = os.path.dirname(sys.argv[-1])
    if folder:
        os.makedirs(folder, exist_ok=True)
    sys.argv = [script] + sys.argv[1:]
    runpy.run_path(script, run_name="__main__")
