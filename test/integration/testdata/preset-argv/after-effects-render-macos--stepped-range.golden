preset: after-effects-render-macos
case:   stepped-range
params:
  Frames=1-9:4
  FramesPerTask=10
  RenderQueueItem=2
  SceneFile=/Volumes/Show Files/spot/o'brien_v002.aep

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: /bin/sh
  args:
    [0]  <WORKDIR>
    [1]  -project
    [2]  /Volumes/Show Files/spot/o'brien_v002.aep
    [3]  -rqindex
    [4]  2
    [5]  -s
    [6]  1
    [7]  -e
    [8]  1
    [9]  -v
    [10]  ERRORS_AND_PROGRESS
    [11]  -close
    [12]  DO_NOT_SAVE_CHANGES
  embedded file "aerender_wrapper" (aerender_wrapper.sh):
    dir=
    trap '[ -z "$dir" ] || rm -rf "$dir"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    dir=$(mktemp -d "${TMPDIR:-/tmp}/aerender_wrapper.XXXXXX") || { echo 'aerender_wrapper: cannot create a temporary directory' >&2; exit 1; }
    { aerender "$@" 2>&1; echo "$?" >"$dir/status"; } | tee "$dir/log" || { echo 'aerender_wrapper: tee failed, so the output was not checked' >&2; exit 1; }
    status=$(cat "$dir/status" 2>/dev/null)
    case $status in
    0) ;;
    '') echo 'aerender_wrapper: aerender exit status unknown' >&2; exit 1 ;;
    *) exit "$status" ;;
    esac
    grep -qiF 'aerender ERROR' "$dir/log"
    case $? in
    0) exit 1 ;;
    1) exit 0 ;;
    *) echo 'aerender_wrapper: cannot read the output back' >&2; exit 1 ;;
    esac

task 2/3  name="Render[Frame=5-5,Frame.End=5,Frame.Start=5]"
  task params:
    Frame=5-5
    Frame.End=5
    Frame.Start=5
  command: /bin/sh
  args:
    [0]  <WORKDIR>
    [1]  -project
    [2]  /Volumes/Show Files/spot/o'brien_v002.aep
