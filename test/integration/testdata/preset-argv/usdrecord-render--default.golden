preset: usdrecord-render
case:   default
params:
  Camera=
  Frames=1-20
  FramesPerTask=10
  ImageWidth=960
  OutputFile=/mnt/show/seq010/shot0010/review/shot0010.####.png
  Renderer=
  SceneFile=/mnt/show/seq010/shot0010/usd/shot0010_layout.usd

step "Render" — 2 tasks

task 1/2  name="Render[Frame=1-10]"
  task params:
    Frame=1-10
  command: hython
  args:
    [0]  <WORKDIR>
    [1]  --imageWidth
    [2]  960
    [3]  --frames
    [4]  1:10
    [5]  /mnt/show/seq010/shot0010/usd/shot0010_layout.usd
    [6]  /mnt/show/seq010/shot0010/review/shot0010.####.png
  embedded file "launcher" (launcher.py):
    import os, runpy, sys
    script = os.path.join(os.environ["HFS"], "bin", "usdrecord")
    # usdrecord does not create the output folder; the last argument
    # is the output pattern.
    folder = os.path.dirname(sys.argv[-1])
    if folder:
        os.makedirs(folder, exist_ok=True)
    sys.argv = [script] + sys.argv[1:]
    runpy.run_path(script, run_name="__main__")

task 2/2  name="Render[Frame=11-20]"
  task params:
    Frame=11-20
  command: hython
  args:
    [0]  <WORKDIR>
    [1]  --imageWidth
    [2]  960
    [3]  --frames
    [4]  11:20
    [5]  /mnt/show/seq010/shot0010/usd/shot0010_layout.usd
    [6]  /mnt/show/seq010/shot0010/review/shot0010.####.png
  embedded file "launcher" (launcher.py):
    import os, runpy, sys
    script = os.path.join(os.environ["HFS"], "bin", "usdrecord")
    # usdrecord does not create the output folder; the last argument
    # is the output pattern.
    folder = os.path.dirname(sys.argv[-1])
    if folder:
        os.makedirs(folder, exist_ok=True)
    sys.argv = [script] + sys.argv[1:]
    runpy.run_path(script, run_name="__main__")
