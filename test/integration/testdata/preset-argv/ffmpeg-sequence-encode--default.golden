    [7]  -frames:v
    [8]  24
    [9]  -c:v
    [10]  libx264
    [11]  -crf
    [12]  20
    [13]  -pix_fmt
    [14]  yuv420p
    [15]  /mnt/show/seq010/shot0010/movies/shot0010_beauty.mp4
