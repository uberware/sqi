preset: ffmpeg-sequence-encode
case:   default
params:
  EndFrame=24
  FrameRate=24
  OutputDir=/mnt/show/seq010/shot0010/movies
  Quality=20
  SourcePattern=/mnt/show/seq010/shot0010/images/shot0010_beauty_%04d.exr
  StartFrame=1
