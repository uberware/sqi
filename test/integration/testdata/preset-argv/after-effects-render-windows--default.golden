  embedded file "aerender_wrapper" (aerender_wrapper.ps1):
    ﻿trap { [Console]::Error.WriteLine('aerender_wrapper: ' + $_); exit 1 }
    $ErrorActionPreference = 'Continue'
    $failed = $false
    & aerender @args 2>&1 | ForEach-Object { $line = [string]$_; $line; if ($line -like '*aerender ERROR*') { $failed = $true } }
    if ($LASTEXITCODE) { exit $LASTEXITCODE }
    if ($failed) { exit 1 }
    exit 0

