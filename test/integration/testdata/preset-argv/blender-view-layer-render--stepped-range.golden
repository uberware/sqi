preset: blender-view-layer-render
case:   stepped-range
params:
  Frames=1-9:4
  OutputPath=/mnt/show/seq010/shot0010/images/shot0010_####.png
  Scene=Scene
  SceneFile=/mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend
  ViewLayer=Beauty

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: blender
  args:
    [0]  -b
    [1]  /mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend
    [2]  -S
    [3]  Scene
    [4]  -o
    [5]  /mnt/show/seq010/shot0010/images/shot0010_####.png
    [6]  -s
    [7]  1
    [8]  -e
    [9]  1
    [10]  --python-exit-code
    [11]  1
    [12]  --python-expr
    [13]  import sys, bpy; name = sys.argv[sys.argv.index('--') + 1]; layers = bpy.context.scene.view_layers; any(l.name == name for l in layers) or sys.exit('no view layer named ' + repr(name) + ' in scene ' + repr(bpy.context.scene.name)); [setattr(l, 'use', l.name == name) for l in layers]
    [14]  -a
    [15]  --
    [16]  Beauty

task 2/3  name="Render[Frame=5-5,Frame.End=5,Frame.Start=5]"
  task params:
    Frame=5-5
    Frame.End=5
    Frame.Start=5
  command: blender
  args:
    [0]  -b
    [1]  /mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend
    [2]  -S
    [3]  Scene
    [4]  -o
    [5]  /mnt/show/seq010/shot0010/images/shot0010_####.png
    [6]  -s
    [7]  5
    [8]  -e
    [9]  5
    [10]  --python-exit-code
    [11]  1
    [12]  --python-expr
    [13]  import sys, bpy; name = sys.argv[sys.argv.index('--') + 1]; layers = bpy.context.scene.view_layers; any(l.name == name for l in layers) or sys.exit('no view layer named ' + repr(name) + ' in scene ' + repr(bpy.context.scene.name)); [setattr(l, 'use', l.name == name) for l in layers]
    [14]  -a
    [15]  --
    [16]  Beauty

task 3/3  name="Render[Frame=9-9,Frame.End=9,Frame.Start=9]"
  task params:
    Frame=9-9
    Frame.End=9
    Frame.Start=9
