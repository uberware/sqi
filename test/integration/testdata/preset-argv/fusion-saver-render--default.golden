    -- if the string is malformed or unterminated. repr_json writes every
    -- non-ASCII character as \uXXXX, which this turns back into UTF-8.
    local function read_json_string(text, pos)
        local parts = {}
        local i = pos + 1
        local n = #text
        while i <= n do
            local c = text:sub(i, i)
            if c == "\"" then
                return table.concat(parts), i + 1
            elseif c == "\\" then
                local e = text:sub(i + 1, i + 1)
                if e == "u" then
                    local hex = text:match("^%x%x%x%x", i + 2)
                    if hex == nil then
                        return nil
                    end
                    local cp = tonumber(hex, 16)
                    i = i + 6
                    if cp >= 55296 and cp <= 56319 then
                        -- A high surrogate: combine it with the low one that
                        -- must follow.
                        local low = text:match("^\\u(%x%x%x%x)", i)
                        local lowcp = low and tonumber(low, 16) or 0
                        if lowcp >= 56320 and lowcp <= 57343 then
                            cp = 65536 + (cp - 55296) * 1024 + (lowcp - 56320)
                            i = i + 6
                        else
                            cp = 65533
                        end
                    elseif cp >= 56320 and cp <= 57343 then
                        cp = 65533
                    end
                    parts[#parts + 1] = utf8_encode(cp)
                else
                    local simple = JSON_SIMPLE_ESCAPES[e]
                    if simple == nil then
                        return nil
                    end
                    parts[#parts + 1] = simple
                    i = i + 2
                end
            else
                parts[#parts + 1] = c
                i = i + 1
            end
        end
        return nil
    end
    
    -- params.json: one JSON object whose values are strings and whole
    -- numbers. Anything else is refused.
    local function parse_params(text)
        local bad = "params.json is not the JSON object this script expects"
        local p = {}
        local pos = text:match("^%s*{%s*()")
        if pos == nil then
            error(bad, 0)
        end
        if text:sub(pos, pos) == "}" then
            return p
        end
        while true do
            if text:sub(pos, pos) ~= "\"" then
                error(bad, 0)
            end
            local key, after = read_json_string(text, pos)
            if key == nil then
                error(bad, 0)
            end
            pos = text:match("^%s*:%s*()", after)
            if pos == nil then
                error(bad, 0)
            end
            local value
            if text:sub(pos, pos) == "\"" then
                value, after = read_json_string(text, pos)
                if value == nil then
                    error(bad, 0)
                end
            else
                local digits
                digits, after = text:match("^(%-?%d+)()", pos)
                if digits == nil then
                    error(bad, 0)
                end
                value = tonumber(digits)
            end
            p[key] = value
            pos = text:match("^%s*()", after)
            local c = text:sub(pos, pos)
            if c == "}" then
                return p
            end
            if c ~= "," then
                error(bad, 0)
            end
            pos = text:match("^,%s*()", pos)
        end
    end
    
    -- The folder this file is in, from the chunk name dofile gave it.
    local function script_folder()
        local info = debug and debug.getinfo and debug.getinfo(1, "S")
        local source = info and info.source
        if type(source) ~= "string" or source:sub(1, 1) ~= "@" then
            error("cannot tell which folder render.lua is in", 0)
        end
        return source:sub(2):match("^(.*[/\\])") or ""
    end
    
    local function read_params()
        local path = script_folder() .. "params.json"
        local f = io.open(path, "rb")
        if f == nil then
            error("cannot open " .. path, 0)
        end
        local text = f:read("*a")
        f:close()
        local p = parse_params(text)
        for _, key in ipairs({ "comp", "saver" }) do
            if type(p[key]) ~= "string" or p[key] == "" then
                error("params.json: " .. key .. " is not a non-empty string", 0)
            end
        end
        for _, key in ipairs({ "start", "end" }) do
            if type(p[key]) ~= "number" then
                error("params.json: " .. key .. " is not a whole number", 0)
            end
        end
        if p.start > p["end"] then
            error("params.json: start is after end", 0)
        end
        return p
    end
    
    local function attrs_of(tool)
        local ok, attrs = pcall(function()
            return tool:GetAttrs()
        end)
        if ok and type(attrs) == "table" then
            return attrs
        end
        return {}
    end
    
    -- The comp's Savers, sorted by name, as { name, tool } records.
    local function savers_of(comp)
        local list = {}
        for _, tool in pairs(comp:GetToolList(false, "Saver") or {}) do
            local name = attrs_of(tool).TOOLS_Name
            if type(name) == "string" then
                list[#list + 1] = { name = name, tool = tool }
            end
        end
        table.sort(list, function(a, b)
            return a.name < b.name
        end)
        return list
    end
    
    local function names_of(savers)
        local quoted = {}
        for i, saver in ipairs(savers) do
            quoted[i] = quote(saver.name)
        end
        if #quoted == 0 then
            return "none"
        end
        return table.concat(quoted, ", ")
    end
    
    -- Loads the comp, renders the one Saver over the task's frames, and
    -- raises on any failure. A name that is not one of the comp's Savers
    -- fails the task: rendering every Saver instead would write outputs
    -- nobody asked for. The comp is never saved.
    local function render(app, p)
        local comp = app:LoadComp(p.comp)
        if comp == nil then
            error("Fusion could not load the comp " .. p.comp, 0)
        end
        local savers = savers_of(comp)
        local tool = comp:FindTool(p.saver)
        if tool == nil then
            error("the comp has no tool named " .. quote(p.saver) .. "; its Savers are " .. names_of(savers), 0)
        end
        local kind = attrs_of(tool).TOOLS_RegID
        if kind ~= "Saver" then
            error("the tool " .. quote(p.saver) .. " is a " .. tostring(kind)
                .. ", not a Saver; the comp's Savers are " .. names_of(savers), 0)
        end
        for _, saver in ipairs(savers) do
            saver.tool:SetAttrs({ TOOLB_PassThrough = saver.name ~= p.saver })
        end
        local ok = comp:Render({ Start = p.start, End = p["end"], Wait = true })
        if not ok then
            error("Fusion reported that the render did not succeed (Render returned " .. tostring(ok) .. ")", 0)
        end
    end
    
    -- Quit is how a script ends Fusion. If it cannot be called, exit
    -- anyway rather than leave the Render Node running with nothing left
    -- to do.
    local function finish(app, code)
        local ok = app ~= nil and pcall(function()
            app:Quit()
        end)
        if not ok then
            os.exit(code)
        end
    end
    
    local function main()
        local app = fusion or fu
        local ok, err = xpcall(function()
            if app == nil then
                error("no fusion object: render.lua must run inside Fusion", 0)
            end
            render(app, read_params())
        end, function(e)
            pcall(function()
                io.stderr:write(debug.traceback(tostring(e), 2), "\n")
            end)
            return e
        end)
        if ok then
            say(OK)
            finish(app, 0)
            return
        end
        local reason = (tostring(err):gsub("%s+", " "))
        say(FAILED .. reason)
        say("openjd_fail: " .. reason)
        finish(app, 1)
    end
    
    main()
