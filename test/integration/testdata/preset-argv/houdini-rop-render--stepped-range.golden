step "Render" — 3 tasks

task 1/3  name="Render[Frames=1-19:2]"
  task params:
    Frames=1-19:2
  command: hython
  args:
    [0]  <WORKDIR>
    [1]  /mnt/show/seq010/shot0010/scene/shot0010_fx_v004.hip
    [2]  /out/mantra_beauty
    [3]  1-19:2
  embedded file "render_chunk" (render_chunk.py):
    import sys
    import hou
    
    hip, rop_path, frames = sys.argv[1], sys.argv[2], sys.argv[3]
    hou.hipFile.load(hip, ignore_load_warnings=True)
    rop = hou.node(rop_path)
    if rop is None:
        raise SystemExit("no such ROP: " + rop_path)
    # The chunk is a compact frame range such as 1-10, 1-19:2 or
    # 1-3,7,8. Each lo-hi:step part is one render call, and parts
    # that continue one another (7,8 above, a run of two) merge into one.
    ranges = []
    for part in frames.split(","):
        expr, _, step = part.partition(":")
        lo, _, hi = expr.partition("-")
        lo, hi, step = int(lo), int(hi or lo), int(step or 1)
        last = ranges[-1] if ranges else None
        if last and step == last[2] == 1 and lo == last[1] + 1:
            last[1] = hi
        else:
            ranges.append([lo, hi, step])
    for lo, hi, step in ranges:
        rop.render(frame_range=(lo, hi, step))

