    [3]  1-19:2
  embedded file "render_chunk" (render_chunk.py):
    import os
    import re
    import sys
    import hou
    
    hip, rop_path, frames = sys.argv[1], sys.argv[2], sys.argv[3]
    hou.hipFile.load(hip, ignore_load_warnings=True)
    rop = hou.node(rop_path)
    if rop is None:
        raise SystemExit("no such ROP: " + rop_path)
    # The chunk is a compact frame range such as 1-10, 1-19:2 or
    # 1-3,7,8, and frames may be negative (-5-5, -3--1). Each
    # lo-hi:step part is one render call, and parts that continue
    # one another (7,8 above, a run of two) merge into one.
    part_re = re.compile(r"(-?\d+)(?:-(-?\d+)(?::(\d+))?)?")
    ranges = []
    for part in frames.split(","):
        m = part_re.fullmatch(part)
        if m is None:
            raise SystemExit("not a frame range part: " + part)
        lo, hi, step = int(m[1]), int(m[2] or m[1]), int(m[3] or 1)
        last = ranges[-1] if ranges else None
        if last and step == last[2] == 1 and lo == last[1] + 1:
            last[1] = hi
        else:
            ranges.append([lo, hi, step])
    # A PostFrame event marks each finished frame. The directives
    # go to file descriptor 1, where the worker reads them, and
    # the frame named is the chunk's next one in order.
    frame_list = [f for lo, hi, step in ranges for f in range(lo, hi + 1, step)]
    done = [0]
    
    def on_render_event(node, event_type, time):
        if event_type != hou.ropRenderEventType.PostFrame or done[0] >= len(frame_list):
            return
        done[0] += 1
        k, n = done[0], len(frame_list)
        os.write(1, ("openjd_progress: %d\nopenjd_status: rendered frame %d (%d of %d)\n"
                     % (k * 100 // n, frame_list[k - 1], k, n)).encode())
    
    rop.addRenderEventCallback(on_render_event)
    try:
        for lo, hi, step in ranges:
            rop.render(frame_range=(lo, hi, step))
    finally:
        rop.removeRenderEventCallback(on_render_event)

