preset: silhouette-render-all
case:   multi-frame-chunk
params:
  Frames=1-10
  FramesPerTask=5
  SceneFile=/mnt/show/seq010/shot0010/roto/shot0010_roto_v007.sfx

step "Render" — 2 tasks

task 1/2  name="Render[Frame=1-5,Frame.End=5,Frame.Start=1]"
  task params:
    Frame=1-5
    Frame.End=5
    Frame.Start=1
  command: sfxcmd
  args:
    [0]  -all
    [1]  -range
    [2]  1-5
    [3]  /mnt/show/seq010/shot0010/roto/shot0010_roto_v007.sfx

task 2/2  name="Render[Frame=6-10,Frame.End=10,Frame.Start=6]"
  task params:
    Frame=6-10
    Frame.End=10
    Frame.Start=6
  command: sfxcmd
  args:
    [0]  -all
    [1]  -range
    [2]  6-10
    [3]  /mnt/show/seq010/shot0010/roto/shot0010_roto_v007.sfx
