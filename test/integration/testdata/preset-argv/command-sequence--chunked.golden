preset: command-sequence
case:   chunked
params:
  Command=echo starting
sqi-stub-command "$SQI_FRAMES"
# done
  Frames=1-10
  FramesPerTask=5

step "Run" — 2 tasks

task 1/2  name="Run[Frame=1-5,Frame.End=5,Frame.Start=1]"
  task params:
    Frame=1-5
    Frame.End=5
    Frame.Start=1
  command: /bin/sh
  args:
    [0]  -c
    [1]  export SQI_FRAME='1' SQI_FRAME_START='1' SQI_FRAME_END='5' SQI_FRAMES='1-5'; echo starting
sqi-stub-command "$SQI_FRAMES"
# done

task 2/2  name="Run[Frame=6-10,Frame.End=10,Frame.Start=6]"
  task params:
    Frame=6-10
    Frame.End=10
    Frame.Start=6
  command: /bin/sh
  args:
    [0]  -c
    [1]  export SQI_FRAME='6' SQI_FRAME_START='6' SQI_FRAME_END='10' SQI_FRAMES='6-10'; echo starting
sqi-stub-command "$SQI_FRAMES"
# done
