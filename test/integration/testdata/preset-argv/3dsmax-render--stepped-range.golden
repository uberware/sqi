preset: 3dsmax-render
case:   stepped-range
params:
  Frames=1-9:4
  OutputPath=C:\renders\shot0010\beauty_.exr
  SceneFile=C:\Show Files\seq010\shot0010_v003.max

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1-1]"
  task params:
    Frame=1-1
  command: 3dsmaxcmd
  args:
    [0]  -v:5
    [1]  -rfw:0
    [2]  -start:1
    [3]  -end:1
    [4]  -outputName:C:\renders\shot0010\beauty_.exr
    [5]  C:\Show Files\seq010\shot0010_v003.max

task 2/3  name="Render[Frame=5-5]"
  task params:
    Frame=5-5
  command: 3dsmaxcmd
  args:
    [0]  -v:5
    [1]  -rfw:0
    [2]  -start:5
    [3]  -end:5
    [4]  -outputName:C:\renders\shot0010\beauty_.exr
    [5]  C:\Show Files\seq010\shot0010_v003.max

task 3/3  name="Render[Frame=9-9]"
  task params:
    Frame=9-9
  command: 3dsmaxcmd
  args:
    [0]  -v:5
    [1]  -rfw:0
    [2]  -start:9
    [3]  -end:9
    [4]  -outputName:C:\renders\shot0010\beauty_.exr
    [5]  C:\Show Files\seq010\shot0010_v003.max
