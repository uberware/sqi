preset: katana-render
case:   default
params:
  Frames=1-3
  FramesPerTask=1
  RenderNode=beauty
  SceneFile=/mnt/show/seq010/shot0010/lookdev/shot0010_lookdev_v007.katana

step "Render" — 3 tasks
  log checks: failOn "ERROR +\\|"

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: katana
  args:
    [0]  --batch
    [1]  --katana-file=/mnt/show/seq010/shot0010/lookdev/shot0010_lookdev_v007.katana
    [2]  --render-node=beauty
    [3]  -t
    [4]  1-1

task 2/3  name="Render[Frame=2-2,Frame.End=2,Frame.Start=2]"
  task params:
    Frame=2-2
    Frame.End=2
    Frame.Start=2
  command: katana
  args:
    [0]  --batch
    [1]  --katana-file=/mnt/show/seq010/shot0010/lookdev/shot0010_lookdev_v007.katana
    [2]  --render-node=beauty
    [3]  -t
    [4]  2-2

task 3/3  name="Render[Frame=3-3,Frame.End=3,Frame.Start=3]"
  task params:
    Frame=3-3
    Frame.End=3
    Frame.Start=3
  command: katana
  args:
    [0]  --batch
    [1]  --katana-file=/mnt/show/seq010/shot0010/lookdev/shot0010_lookdev_v007.katana
    [2]  --render-node=beauty
    [3]  -t
    [4]  3-3
