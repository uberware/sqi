preset: hython-script
case:   chunked
params:
  Frames=1-10
  FramesPerTask=4
  SceneFile=/mnt/show/seq010/shot0010/fx/shot0010_fx.hip
  Script=print('hello')

step "Run" — 3 tasks

task 1/3  name="Run[Frame=1-4,Frame.End=4,Frame.Start=1]"
  task params:
    Frame=1-4
    Frame.End=4
    Frame.Start=1
  command: hython
  args:
    [0]  <WORKDIR>
    [1]  /mnt/show/seq010/shot0010/fx/shot0010_fx.hip
    [2]  <WORKDIR>
    [3]  1
    [4]  4
    [5]  1-4
  embedded file "launcher" (launcher.py):
    # sqi hython-script launcher: sets the four SQI_FRAME* variables,
    # loads the hip, moves the playbar to the task's first frame and
    # runs the user's script in this process, so the script sees the
    # loaded Houdini session. An exception or a non-zero SystemExit
    # leaves hython with a non-zero exit status, which fails the task.
    import os
    import runpy
    import sys
    
    hip, script, start, end, frames = sys.argv[1:6]
    os.environ.update(SQI_FRAME=start, SQI_FRAME_START=start, SQI_FRAME_END=end, SQI_FRAMES=frames)
    
    import hou
    
    hou.hipFile.load(hip, ignore_load_warnings=True)
    hou.setFrame(int(start))
    
    sys.argv = [script]
    runpy.run_path(script, run_name="__main__")
  embedded file "script" (script.py):
    print('hello')

