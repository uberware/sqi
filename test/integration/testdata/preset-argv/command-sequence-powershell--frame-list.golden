preset: command-sequence-powershell
case:   frame-list
params:
  Command=sqi-stub-command "$env:SQI_FRAMES"
  Frames=1,5,10-20
  FramesPerTask=5

step "Run" — 5 tasks

task 1/5  name="Run[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: powershell
  args:
    [0]  -NoProfile
    [1]  -NonInteractive
    [2]  -ExecutionPolicy
    [3]  Bypass
    [4]  -File
    [5]  <WORKDIR>
  embedded file "command" (command.ps1):
    ﻿$env:SQI_FRAME = '1'
    $env:SQI_FRAME_START = '1'
    $env:SQI_FRAME_END = '1'
    $env:SQI_FRAMES = '1-1'
    sqi-stub-command "$env:SQI_FRAMES"
    $sqiOk = $?
    if ($LASTEXITCODE) { exit $LASTEXITCODE }
    if (-not $sqiOk -and -not ($Error.Count -and $Error[0].FullyQualifiedErrorId -like 'NativeCommandError*')) { exit 1 }
    exit 0

