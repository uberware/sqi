preset: vray-standalone-render
case:   stepped-range
params:
  Frames=1-9:4
  SceneFile=/mnt/show/seq010/shot0010/render/shot0010_lighting.vrscene

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: vray
  args:
    [0]  -sceneFile=/mnt/show/seq010/shot0010/render/shot0010_lighting.vrscene
    [1]  -frames=1-1
    [2]  -display=0
    [3]  -autoClose=1
    [4]  -progressUseColor=0

task 2/3  name="Render[Frame=5-5,Frame.End=5,Frame.Start=5]"
  task params:
    Frame=5-5
    Frame.End=5
    Frame.Start=5
  command: vray
  args:
    [0]  -sceneFile=/mnt/show/seq010/shot0010/render/shot0010_lighting.vrscene
    [1]  -frames=5-5
    [2]  -display=0
    [3]  -autoClose=1
    [4]  -progressUseColor=0

task 3/3  name="Render[Frame=9-9,Frame.End=9,Frame.Start=9]"
  task params:
    Frame=9-9
    Frame.End=9
    Frame.Start=9
  command: vray
  args:
    [0]  -sceneFile=/mnt/show/seq010/shot0010/render/shot0010_lighting.vrscene
    [1]  -frames=9-9
    [2]  -display=0
    [3]  -autoClose=1
    [4]  -progressUseColor=0
