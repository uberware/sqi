preset: vray-standalone-render
case:   default
params:
  Frames=1-3
  SceneFile=/mnt/show/seq010/shot0010/render/shot0010_lighting.vrscene

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: vray
  args:
    [0]  -sceneFile=/mnt/show/seq010/shot0010/render/shot0010_lighting.vrscene
    [1]  -frames=1-1
    [2]  -display=0
    [3]  -autoClose=1
    [4]  -progressUseColor=0
    [5]  -progressUseCR=0

task 2/3  name="Render[Frame=2-2,Frame.End=2,Frame.Start=2]"
  task params:
    Frame=2-2
    Frame.End=2
    Frame.Start=2
  command: vray
  args:
    [0]  -sceneFile=/mnt/show/seq010/shot0010/render/shot0010_lighting.vrscene
    [1]  -frames=2-2
    [2]  -display=0
    [3]  -autoClose=1
    [4]  -progressUseColor=0
    [5]  -progressUseCR=0

task 3/3  name="Render[Frame=3-3,Frame.End=3,Frame.Start=3]"
  task params:
    Frame=3-3
    Frame.End=3
    Frame.Start=3
  command: vray
  args:
    [0]  -sceneFile=/mnt/show/seq010/shot0010/render/shot0010_lighting.vrscene
    [1]  -frames=3-3
    [2]  -display=0
    [3]  -autoClose=1
    [4]  -progressUseColor=0
    [5]  -progressUseCR=0
