preset: after-effects-render
case:   stepped-range
params:
  Frames=1-9:4
  FramesPerTask=10
  RenderQueueItem=2
  SceneFile=C:\Show Files\spot\o'brien_v002.aep

step "Render" — 3 tasks
  log checks: failOn "(?i)aerender ERROR"

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: aerender
  args:
    [0]  -project
    [1]  C:\Show Files\spot\o'brien_v002.aep
    [2]  -rqindex
    [3]  2
    [4]  -s
    [5]  1
    [6]  -e
    [7]  1
    [8]  -v
    [9]  ERRORS_AND_PROGRESS
    [10]  -close
    [11]  DO_NOT_SAVE_CHANGES

task 2/3  name="Render[Frame=5-5,Frame.End=5,Frame.Start=5]"
  task params:
    Frame=5-5
    Frame.End=5
    Frame.Start=5
  command: aerender
  args:
    [0]  -project
    [1]  C:\Show Files\spot\o'brien_v002.aep
    [2]  -rqindex
    [3]  2
    [4]  -s
    [5]  5
    [6]  -e
    [7]  5
    [8]  -v
    [9]  ERRORS_AND_PROGRESS
    [10]  -close
    [11]  DO_NOT_SAVE_CHANGES

task 3/3  name="Render[Frame=9-9,Frame.End=9,Frame.Start=9]"
  task params:
    Frame=9-9
    Frame.End=9
    Frame.Start=9
  command: aerender
  args:
    [0]  -project
    [1]  C:\Show Files\spot\o'brien_v002.aep
    [2]  -rqindex
    [3]  2
    [4]  -s
    [5]  9
    [6]  -e
    [7]  9
    [8]  -v
    [9]  ERRORS_AND_PROGRESS
    [10]  -close
    [11]  DO_NOT_SAVE_CHANGES
