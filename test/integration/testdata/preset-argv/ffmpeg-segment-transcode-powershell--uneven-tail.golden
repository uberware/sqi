step "Join" — 1 task

task 1/1  name="Join"
  command: powershell
  args:
    [0]  -NoProfile
    [1]  -ExecutionPolicy
    [2]  Bypass
    [3]  -File
    [4]  <WORKDIR>
    [5]  C:\show\seq010\shot0010\movies\shot0010_h264.mp4
  embedded file "join" (join.ps1):
    $ErrorActionPreference = 'Stop'
    
    $out = $args[0]
    $dir = Split-Path -Parent $out
    $stem = [System.IO.Path]::GetFileNameWithoutExtension($out)
    $ext = [System.IO.Path]::GetExtension($out)
    
    # Zero-padded slice numbers make lexical order numeric order.
    $segs = Get-ChildItem -Path $dir -Filter "$stem`_seg_*$ext" | Sort-Object Name
    if ($segs.Count -eq 0) {
      Write-Error "no slices found matching $dir\$stem`_seg_*$ext"
      exit 1
    }
    
    $list = [System.IO.Path]::GetTempFileName()
    try {
      $lines = $segs | ForEach-Object { "file '" + $_.FullName + "'" }
      # Encoding is explicit and deliberate: ASCII (Set-Content's implicit
      # choice) silently mangles non-ASCII slice paths, and -Encoding UTF8
      # writes a BOM on Windows PowerShell 5.1 that breaks the concat
      # demuxer's parse of the first "file" line. BOM-less UTF-8 avoids both.
      [System.IO.File]::WriteAllLines($list, $lines, (New-Object System.Text.UTF8Encoding $false))
      ffmpeg -y -f concat -safe 0 -i $list -c copy $out
      if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
      $segs | Remove-Item -Force
    } finally {
      Remove-Item -Force $list -ErrorAction SilentlyContinue
    }
