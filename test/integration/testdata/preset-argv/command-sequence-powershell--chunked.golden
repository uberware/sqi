preset: command-sequence-powershell
case:   chunked
params:
  Command=Write-Host starting
sqi-stub-command "$env:SQI_FRAMES"
# done
  Frames=1-10
  FramesPerTask=5

step "Run" — 2 tasks

task 1/2  name="Run[Frame=1-5,Frame.End=5,Frame.Start=1]"
  task params:
    Frame=1-5
    Frame.End=5
    Frame.Start=1
  command: powershell
  args:
    [0]  -NoProfile
    [1]  -NonInteractive
    [2]  -ExecutionPolicy
    [3]  Bypass
    [4]  -File
    [5]  <WORKDIR>
  embedded file "command" (command.ps1):
    ﻿$env:SQI_FRAME = '1'
    $env:SQI_FRAME_START = '1'
    $env:SQI_FRAME_END = '5'
    $env:SQI_FRAMES = '1-5'
    Write-Host starting
    sqi-stub-command "$env:SQI_FRAMES"
    # done
    $sqiOk = $?
    if ($LASTEXITCODE) { exit $LASTEXITCODE }
    if (-not $sqiOk -and -not ($Error.Count -and $Error[0].FullyQualifiedErrorId -like 'NativeCommandError*')) { exit 1 }
    exit 0

task 2/2  name="Run[Frame=6-10,Frame.End=10,Frame.Start=6]"
  task params:
    Frame=6-10
    Frame.End=10
    Frame.Start=6
  command: powershell
  args:
    [0]  -NoProfile
    [1]  -NonInteractive
    [2]  -ExecutionPolicy
    [3]  Bypass
    [4]  -File
    [5]  <WORKDIR>
  embedded file "command" (command.ps1):
    ﻿$env:SQI_FRAME = '6'
    $env:SQI_FRAME_START = '6'
    $env:SQI_FRAME_END = '10'
    $env:SQI_FRAMES = '6-10'
    Write-Host starting
    sqi-stub-command "$env:SQI_FRAMES"
    # done
    $sqiOk = $?
    if ($LASTEXITCODE) { exit $LASTEXITCODE }
    if (-not $sqiOk -and -not ($Error.Count -and $Error[0].FullyQualifiedErrorId -like 'NativeCommandError*')) { exit 1 }
    exit 0
