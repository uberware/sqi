preset: fusion-render
case:   stepped-range
params:
  Frames=1-9:4
  FramesPerTask=10
  SceneFile=/mnt/show/seq010/shot0010/comp/shot0010_comp_v007.comp

step "Render" — 3 tasks
  log checks: failOn "The fusion renderer reported that the render failed"
  log checks: failOn "Failed to load the comp"

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: FusionRenderNode
  args:
    [0]  /mnt/show/seq010/shot0010/comp/shot0010_comp_v007.comp
    [1]  -render
    [2]  -start
    [3]  1
    [4]  -end
    [5]  1
    [6]  -quiet
    [7]  -verbose
    [8]  -quit

task 2/3  name="Render[Frame=5-5,Frame.End=5,Frame.Start=5]"
  task params:
    Frame=5-5
    Frame.End=5
    Frame.Start=5
  command: FusionRenderNode
  args:
    [0]  /mnt/show/seq010/shot0010/comp/shot0010_comp_v007.comp
    [1]  -render
    [2]  -start
    [3]  5
    [4]  -end
    [5]  5
    [6]  -quiet
    [7]  -verbose
    [8]  -quit

task 3/3  name="Render[Frame=9-9,Frame.End=9,Frame.Start=9]"
  task params:
    Frame=9-9
    Frame.End=9
    Frame.Start=9
  command: FusionRenderNode
  args:
    [0]  /mnt/show/seq010/shot0010/comp/shot0010_comp_v007.comp
    [1]  -render
    [2]  -start
    [3]  9
    [4]  -end
    [5]  9
    [6]  -quiet
    [7]  -verbose
    [8]  -quit
