preset: oiiotool-process
case:   padding-and-step
params:
  Frames=1001-1009:4
  FramesPerTask=10
  InputFile=/mnt/show/seq010/shot0010/comp/in.######.exr
  Operations=[]
  OutputFile=/mnt/show/seq010/shot0010/review/out.######.exr

step "Process" — 3 tasks

task 1/3  name="Process[Frame=1001-1001]"
  task params:
    Frame=1001-1001
