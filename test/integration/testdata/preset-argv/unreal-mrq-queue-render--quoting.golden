  embedded file "params" (params.json):
    {"queue": "/Game/Cinematics/it's the \"hero\" \\ queue", "output_directory": "C:\\Renders\\Hero Film\\it's the \"hero\" queue"}
  embedded file "render" (sqi_unreal_render.py):
    # sqi Unreal presets: renders a Movie Render Queue job, one shot of a
    # job, or a saved queue in the editor. The editor imports it from its
    # -execcmds startup command; its parameters come from params.json,
    # never from its own text. It starts the render and returns. Unreal
    # reports the outcome later, through the executor's delegates, and
    # only then does the script print its verdict and quit the editor.
    import json
    import os
    import traceback
    
    import unreal
    
    OK = "SQI_RENDER: OK"
    FAILED = "SQI_RENDER: FAILED: "
    
    # What the delegates need once main() has returned: the executor
    # (Unreal holds it while it renders; this keeps a reference too),
    # the failures reported so far, whether a verdict was given, and
    # the job counts behind openjd_progress.
    STATE = dict(executor=None, failures=[], done=False, total=0, finished=0)
    
    
    def emit(line, fd=1):
        # Straight to the file descriptor the worker reads, past
        # whatever Unreal does with sys.stdout. A failed write is
        # ignored: the task then fails for want of the OK line.
        try:
            os.write(fd, (line + "\n").encode("utf-8", "replace"))
        except (OSError, UnicodeError):
            pass
    
    
    def say(line):
        # Both ways out: descriptor 1, and Unreal's log, which -stdout
        # copies to the output behind a LogPython: prefix. The checks
        # match anywhere in a line, so either copy counts.
        emit(line)
        try:
            unreal.log(line)
        except Exception:
            pass
    
    
    def find_params():
        # params.json sits beside this script, in the task's session
        # folder. The current folder is a fallback for when the script's
        # own location is unknown; Unreal's startup may change it from the
        # worker's starting folder.
        found = []
        here = globals().get("__file__")
        if here:
            found.append(os.path.join(os.path.dirname(os.path.abspath(here)), "params.json"))
        found.append(os.path.join(os.getcwd(), "params.json"))
        for path in found:
            if os.path.isfile(path):
                return path
        raise IOError("params.json not found; looked at " + ", ".join(found))
    
    
    def read_params(path):
        with open(path, encoding="utf-8") as f:
            p = json.load(f)
        # A queue preset's file names a queue; a job preset's names the
        # three assets of its one job, and a shot preset's also the shot
        # of that job to render.
        if "queue" in p:
            keys = ["queue"]
        else:
            keys = ["sequence", "map", "config"] + (["shot"] if "shot" in p else [])
        params = dict()
        for key in keys + ["output_directory"]:
            value = p.get(key, "")
            if not isinstance(value, str):
                raise ValueError("params.json: " + key + " is not a string")
            if key != "output_directory" and not value:
                raise ValueError("params.json: " + key + " is empty")
            params[key] = value
        return params
    
    
    def object_path(path):
        # A soft object path names an asset as Package.Asset; a bare package
        # path such as /Game/Maps/Hero names the package, not the asset in it.
        # Content Browser paths leave the asset name off, and it is the
        # package's last segment, so add it. A path that names its asset is
        # kept as it is.
        leaf = path.rsplit("/", 1)[-1]
        return path if "." in leaf else path + "." + leaf
    
    
    def asset_name(path):
        # The asset's own name: /Game/Cinematics/SEQ_Hero.SEQ_Hero -> SEQ_Hero.
        return path.rsplit("/", 1)[-1].split(".")[0]
    
    
    def build_queue(subsystem, params):
        # The editor's own queue, emptied, then filled with the one job
        # these parameters describe or with a copy of the saved queue's
        # jobs (the saved asset itself is never changed).
        queue = subsystem.get_queue()
        queue.delete_all_jobs()
        if "queue" in params:
            saved = unreal.EditorAssetLibrary.load_asset(params["queue"])
            if saved is None:
                raise ValueError("no Movie Pipeline Queue asset at " + params["queue"])
            queue.copy_from(saved)
        else:
            config = unreal.EditorAssetLibrary.load_asset(params["config"])
            if config is None:
                raise ValueError("no Movie Render Queue config asset at " + params["config"])
            job = queue.allocate_new_job(unreal.MoviePipelineExecutorJob)
            job.sequence = unreal.SoftObjectPath(object_path(params["sequence"]))
            job.map = unreal.SoftObjectPath(object_path(params["map"]))
            job.set_configuration(config)
            job.job_name = asset_name(params["sequence"])
        jobs = list(queue.get_jobs())
        if not jobs:
            raise ValueError("the queue holds no jobs")
        return jobs
    
    
    def select_shot(jobs, params):
        # One shot of the job: its shot list rebuilt from the sequence,
        # then only the entries named after the shot left enabled. An
        # entry is named by its outer name: its section's name in the
        # shot track, or "no shot" in a sequence without one (Unreal
        # 5.8). An entry with no outer name is named after the sequence.
        # A shot the sequence lacks fails the task, naming the shots it
        # has, rather than render every shot.
        shot = params["shot"]
        sequence = unreal.EditorAssetLibrary.load_asset(object_path(params["sequence"]))
        if sequence is None:
            raise ValueError("no level sequence asset at " + params["sequence"])
        for job in jobs:
            unreal.MoviePipelineLibrary.update_job_shot_list_from_sequence(sequence, job)
            entries = list(job.shot_info)
            names = [str(entry.outer_name or "") or asset_name(params["sequence"]) for entry in entries]
            if shot not in names:
                have = ", ".join(json.dumps(name, ensure_ascii=False) for name in names) or "none"
                raise ValueError(
                    "the level sequence has no shot named " + json.dumps(shot, ensure_ascii=False)
                    + "; its shots are " + have
                )
            for entry, name in zip(entries, names):
                entry.enabled = name == shot
            # Every shot's task renders with the same config, so without
            # {shot_name} in the file names one shot's frames can replace
            # another's. This only warns, since the output directory may
            # tell them apart.
            setting = job.get_configuration().find_or_add_setting_by_class(unreal.MoviePipelineOutputSetting)
            if "{shot_name}" not in str(setting.file_name_format or ""):
                say("sqi: the output file name format has no {shot_name}; shots may overwrite each other")
    
    
    def apply_output(jobs, directory):
        # Blank keeps every job's own output directory.
        if not directory:
            return
        os.makedirs(directory, exist_ok=True)
        path = unreal.DirectoryPath()
        path.set_editor_property("path", directory.replace("\\", "/"))
        for job in jobs:
            # A job that still names the config asset it was made from,
            # as a queue saved from the Movie Render Queue window does,
            # has that asset copied over its settings again when the
            # render starts, which would undo the directory set here.
            # Setting the same asset as the job's own configuration keeps
            # its settings and drops that link.
            origin = job.get_preset_origin()
            if origin is not None:
                job.set_configuration(origin)
            setting = job.get_configuration().find_or_add_setting_by_class(unreal.MoviePipelineOutputSetting)
            setting.output_directory = path
    
    
    def reason_of(e):
        return " ".join((type(e).__name__ + ": " + str(e)).split())
    
    
    def finish(code):
        # quit_editor is how Unreal's own scripts end the editor. If it
        # cannot be called, exit anyway rather than leave the editor
        # running with nothing left to do.
        try:
            unreal.SystemLibrary.quit_editor()
        except Exception:
            os._exit(code)
    
    
    def conclude(reason=None):
        # One verdict per task, whichever delegate comes first.
        if STATE["done"]:
            return
        STATE["done"] = True
        if reason is None and STATE["failures"]:
            reason = "; ".join(STATE["failures"])
        if reason is None:
            say(OK)
            finish(0)
            return
        reason = " ".join(reason.split())
        say(FAILED + reason)
        emit("openjd_fail: " + reason)
        finish(1)
    
    
    def crash(e):
        emit(traceback.format_exc(), fd=2)
        conclude(reason_of(e))
    
    
    def on_errored(executor, pipeline, is_fatal, error_text):
        try:
            text = " ".join(str(error_text).split())
            if not is_fatal:
                say("sqi: Movie Render Queue reported a non-fatal error: " + text)
                return
            # A fatal error ends the render; Epic's own render-farm
            # plug-in quits the editor on this delegate too.
            STATE["failures"].append("Movie Render Queue error: " + text)
            conclude()
        except Exception as e:
            crash(e)
    
    
    def on_job_finished(output):
        try:
            job = getattr(output, "job", None)
            name = str(getattr(job, "job_name", "") or "?")
            if not getattr(output, "success", True):
                STATE["failures"].append("job " + name + " did not succeed")
            elif STATE["total"]:
                # The share of the queue's jobs done; a job that
                # failed reports none. A shot task has no total: it
                # renders one job and reports which shot at the start.
                STATE["finished"] += 1
                emit("openjd_status: finished job " + name)
                emit("openjd_progress: %d" % min(100, STATE["finished"] * 100 // STATE["total"]))
        except Exception as e:
            crash(e)
    
    
    def on_finished(executor, success):
        try:
            if not success and not STATE["failures"]:
                STATE["failures"].append("Movie Render Queue reported that the render did not succeed")
            conclude()
        except Exception as e:
            crash(e)
    
    
    def main():
        try:
            params = read_params(find_params())
            unreal.AssetRegistryHelpers.get_asset_registry().wait_for_completion()
            subsystem = unreal.get_editor_subsystem(unreal.MoviePipelineQueueSubsystem)
            jobs = build_queue(subsystem, params)
            if "shot" in params:
                select_shot(jobs, params)
                emit("openjd_status: rendering " + params["shot"])
            else:
                # A disabled job is never rendered, so it is not counted.
                STATE["total"] = sum(1 for j in jobs if getattr(j, "enabled", True))
            apply_output(jobs, params["output_directory"])
            executor = unreal.MoviePipelinePIEExecutor()
            STATE["executor"] = executor
            executor.on_executor_errored_delegate.add_callable(on_errored)
            executor.on_executor_finished_delegate.add_callable(on_finished)
            per_job = getattr(executor, "on_individual_job_work_finished_delegate", None)
            if per_job is not None:
                per_job.add_callable(on_job_finished)
            subsystem.render_queue_with_executor_instance(executor)
        except Exception as e:
            crash(e)
    
    
    main()
