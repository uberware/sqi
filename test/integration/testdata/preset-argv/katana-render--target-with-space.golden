preset: katana-render
case:   target-with-space
params:
  Frames=1-2
  FramesPerTask=1
  RenderNode=Shot A Beauty
  SceneFile=/mnt/show/seq010/shot 0010/lookdev/shot0010_lookdev_v007.katana

step "Render" — 2 tasks
  log checks: failOn "ERROR +\\|"

task 1/2  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: katana
  args:
    [0]  --batch
    [1]  --katana-file=/mnt/show/seq010/shot 0010/lookdev/shot0010_lookdev_v007.katana
    [2]  --render-node=Shot A Beauty
    [3]  -t
    [4]  1-1

task 2/2  name="Render[Frame=2-2,Frame.End=2,Frame.Start=2]"
  task params:
    Frame=2-2
    Frame.End=2
    Frame.Start=2
  command: katana
  args:
    [0]  --batch
    [1]  --katana-file=/mnt/show/seq010/shot 0010/lookdev/shot0010_lookdev_v007.katana
    [2]  --render-node=Shot A Beauty
    [3]  -t
    [4]  2-2
