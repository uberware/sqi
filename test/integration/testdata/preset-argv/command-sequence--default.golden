preset: command-sequence
case:   default
params:
  Command=sqi-stub-command "$SQI_FRAME" "$SQI_FRAME_START" "$SQI_FRAME_END" "$SQI_FRAMES"
  Frames=1-3
  FramesPerTask=1

step "Run" — 3 tasks

task 1/3  name="Run[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: /bin/sh
  args:
    [0]  -c
    [1]  export SQI_FRAME='1' SQI_FRAME_START='1' SQI_FRAME_END='1' SQI_FRAMES='1-1'; sqi-stub-command "$SQI_FRAME" "$SQI_FRAME_START" "$SQI_FRAME_END" "$SQI_FRAMES"

task 2/3  name="Run[Frame=2-2,Frame.End=2,Frame.Start=2]"
  task params:
    Frame=2-2
    Frame.End=2
    Frame.Start=2
  command: /bin/sh
  args:
    [0]  -c
    [1]  export SQI_FRAME='2' SQI_FRAME_START='2' SQI_FRAME_END='2' SQI_FRAMES='2-2'; sqi-stub-command "$SQI_FRAME" "$SQI_FRAME_START" "$SQI_FRAME_END" "$SQI_FRAMES"

task 3/3  name="Run[Frame=3-3,Frame.End=3,Frame.Start=3]"
  task params:
    Frame=3-3
    Frame.End=3
    Frame.Start=3
  command: /bin/sh
  args:
    [0]  -c
    [1]  export SQI_FRAME='3' SQI_FRAME_START='3' SQI_FRAME_END='3' SQI_FRAMES='3-3'; sqi-stub-command "$SQI_FRAME" "$SQI_FRAME_START" "$SQI_FRAME_END" "$SQI_FRAMES"
