preset: mantra-render
case:   default
params:
  Frames=1-3
  SceneFile=/mnt/show/seq010/shot0010/ifd/shot0010_beauty.####.ifd

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1]"
  task params:
    Frame=1
  command: mantra
  args:
    [0]  -V
    [1]  2a
    [2]  -f
    [3]  /mnt/show/seq010/shot0010/ifd/shot0010_beauty.0001.ifd

task 2/3  name="Render[Frame=2]"
  task params:
    Frame=2
  command: mantra
  args:
    [0]  -V
    [1]  2a
    [2]  -f
    [3]  /mnt/show/seq010/shot0010/ifd/shot0010_beauty.0002.ifd

task 3/3  name="Render[Frame=3]"
  task params:
    Frame=3
  command: mantra
  args:
    [0]  -V
    [1]  2a
    [2]  -f
    [3]  /mnt/show/seq010/shot0010/ifd/shot0010_beauty.0003.ifd
