preset: silhouette-render-all
case:   default
params:
  Frames=1-25
  FramesPerTask=10
  SceneFile=/mnt/show/seq010/shot0010/roto/shot0010_roto_v007.sfx

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1-9,Frame.End=9,Frame.Start=1]"
  task params:
    Frame=1-9
    Frame.End=9
    Frame.Start=1
  command: sfxcmd
  args:
    [0]  -all
    [1]  -range
    [2]  1-9
    [3]  /mnt/show/seq010/shot0010/roto/shot0010_roto_v007.sfx

task 2/3  name="Render[Frame=10-17,Frame.End=17,Frame.Start=10]"
  task params:
    Frame=10-17
    Frame.End=17
    Frame.Start=10
  command: sfxcmd
  args:
    [0]  -all
    [1]  -range
    [2]  10-17
    [3]  /mnt/show/seq010/shot0010/roto/shot0010_roto_v007.sfx

task 3/3  name="Render[Frame=18-25,Frame.End=25,Frame.Start=18]"
  task params:
    Frame=18-25
    Frame.End=25
    Frame.Start=18
  command: sfxcmd
  args:
    [0]  -all
    [1]  -range
    [2]  18-25
    [3]  /mnt/show/seq010/shot0010/roto/shot0010_roto_v007.sfx
