preset: blender-view-layer-render
case:   quoted-layer
params:
  Frames=1-3
  OutputPath=/mnt/show/seq010/shot0010/images/shot0010_####.png
  Scene=Shot 010
  SceneFile=/mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend
  ViewLayer=It's "Main" layer

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: blender
  args:
    [0]  -b
    [1]  /mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend
    [2]  -S
    [3]  Shot 010
    [4]  -o
    [5]  /mnt/show/seq010/shot0010/images/shot0010_####.png
    [6]  -s
    [7]  1
    [8]  -e
    [9]  1
    [10]  --python-exit-code
    [11]  1
    [12]  --python-expr
    [13]  import sys, bpy; name, scene = sys.argv[sys.argv.index('--') + 1:][:2]; bpy.context.scene.name == scene or sys.exit('no scene named ' + repr(scene) + ' in the file'); layers = bpy.context.scene.view_layers; any(l.name == name for l in layers) or sys.exit('no view layer named ' + repr(name) + ' in scene ' + repr(scene)); [setattr(l, 'use', l.name == name) for l in layers]
    [14]  -a
    [15]  --
    [16]  It's "Main" layer
    [17]  Shot 010

