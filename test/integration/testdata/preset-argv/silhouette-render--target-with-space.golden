preset: silhouette-render
case:   target-with-space
params:
  Frames=1-2
  FramesPerTask=1
  OutputNode=Final Matte
  SceneFile=/mnt/show/seq010/shot 0010/roto/shot0010_roto_v007.sfx
  Session=Hero Roto

step "Render" — 2 tasks

task 1/2  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: sfxcmd
  args:
    [0]  -session
    [1]  Hero Roto
    [2]  -node
    [3]  Final Matte
    [4]  -range
    [5]  1-1
    [6]  /mnt/show/seq010/shot 0010/roto/shot0010_roto_v007.sfx

task 2/2  name="Render[Frame=2-2,Frame.End=2,Frame.Start=2]"
  task params:
    Frame=2-2
    Frame.End=2
    Frame.Start=2
  command: sfxcmd
  args:
    [0]  -session
    [1]  Hero Roto
    [2]  -node
    [3]  Final Matte
    [4]  -range
    [5]  2-2
    [6]  /mnt/show/seq010/shot 0010/roto/shot0010_roto_v007.sfx
