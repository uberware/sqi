preset: oiiotool-process
case:   operations
params:
  Frames=1
  FramesPerTask=10
  InputFile=/mnt/show/seq010/shot0010/comp/in.####.exr
  Operations=["--resize", "50%", "--colorconvert", "linear", "sRGB"]
  OutputFile=/mnt/show/seq010/shot0010/review/out.####.jpg

step "Process" — 1 task
  log progress: frameParameter "Frame"
  log progress: progress "^Wrote frame (?P<framedone>-?\\d+)$"
  log progress: status "^(?P<status>Wrote frame -?\\d+)$"

task 1/1  name="Process[Frame=1-1]"
  task params:
    Frame=1-1
  command: oiiotool
  args:
    [0]  --frames
    [1]  1-1
    [2]  /mnt/show/seq010/shot0010/comp/in.@@@@.exr
    [3]  --resize
    [4]  50%
    [5]  --colorconvert
    [6]  linear
    [7]  sRGB
    [8]  -o
    [9]  /mnt/show/seq010/shot0010/review/out.@@@@.jpg
    [10]  --echo
    [11]  Wrote frame {FRAME_NUMBER}
