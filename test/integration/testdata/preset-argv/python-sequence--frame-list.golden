    # sqi python-sequence launcher: runs the user's script as a child
    # process with the four SQI_FRAME* variables added to its
    # environment, and exits with the child's exit code.
    import os
    import signal
    import subprocess
    import sys
    
    
    def _wait_for_child(signum, frame):
        # Cancellation signals the whole process group, so the child
        # receives this signal itself; the launcher stays alive to
        # report its exit code. A handler, not SIG_IGN: an ignored
        # signal stays ignored in the child across exec.
        pass
    
    
    for _name in ("SIGTERM", "SIGINT"):
        _sig = getattr(signal, _name, None)
        if _sig is not None:
            signal.signal(_sig, _wait_for_child)
    
    script, start, end, frames = sys.argv[1:5]
    env = dict(os.environ)
    env.update(SQI_FRAME=start, SQI_FRAME_START=start, SQI_FRAME_END=end, SQI_FRAMES=frames)
    code = subprocess.call([sys.executable, script], env=env)
    sys.exit(128 - code if code < 0 else code)
  embedded file "script" (script.py):
    print('hello')

