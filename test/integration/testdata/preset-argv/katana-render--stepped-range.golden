preset: katana-render
case:   stepped-range
params:
  Frames=1-9:4
  FramesPerTask=1
  RenderNode=beauty
  SceneFile=/mnt/show/seq010/shot0010/lookdev/shot0010_lookdev_v007.katana

step "Render" — 3 tasks
  log checks: failOn "ERROR +\\|"

task 1/3  name="Render[Frame=1-1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1-1
    Frame.End=1
    Frame.Start=1
  command: katana
  args:
    [0]  --batch
    [1]  --katana-file=/mnt/show/seq010/shot0010/lookdev/shot0010_lookdev_v007.katana
    [2]  --render-node=beauty
    [3]  -t
    [4]  1-1

task 2/3  name="Render[Frame=5-5,Frame.End=5,Frame.Start=5]"
  task params:
    Frame=5-5
    Frame.End=5
    Frame.Start=5
  command: katana
  args:
    [0]  --batch
    [1]  --katana-file=/mnt/show/seq010/shot0010/lookdev/shot0010_lookdev_v007.katana
    [2]  --render-node=beauty
    [3]  -t
    [4]  5-5

task 3/3  name="Render[Frame=9-9,Frame.End=9,Frame.Start=9]"
  task params:
    Frame=9-9
    Frame.End=9
    Frame.Start=9
  command: katana
  args:
    [0]  --batch
    [1]  --katana-file=/mnt/show/seq010/shot0010/lookdev/shot0010_lookdev_v007.katana
    [2]  --render-node=beauty
    [3]  -t
    [4]  9-9
