preset: blender-batch-render
case:   default
params:
  Frames=1-3
  OutputPath=/mnt/show/seq010/shot0010/images/shot0010_####.png
  SceneFile=/mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend

step "Render" — 3 tasks

task 1/3  name="Render[Frame=1,Frame.End=1,Frame.Start=1]"
  task params:
    Frame=1
    Frame.End=1
    Frame.Start=1
  command: blender
  args:
    [0]  -b
    [1]  /mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend
    [2]  -o
    [3]  /mnt/show/seq010/shot0010/images/shot0010_####.png
    [4]  -s
    [5]  1
    [6]  -e
    [7]  1
    [8]  -a

task 2/3  name="Render[Frame=2,Frame.End=2,Frame.Start=2]"
  task params:
    Frame=2
    Frame.End=2
    Frame.Start=2
  command: blender
  args:
    [0]  -b
    [1]  /mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend
    [2]  -o
    [3]  /mnt/show/seq010/shot0010/images/shot0010_####.png
    [4]  -s
    [5]  2
    [6]  -e
    [7]  2
    [8]  -a

task 3/3  name="Render[Frame=3,Frame.End=3,Frame.Start=3]"
  task params:
    Frame=3
    Frame.End=3
    Frame.Start=3
  command: blender
  args:
    [0]  -b
    [1]  /mnt/show/seq010/shot0010/scene/shot0010_anim_v007.blend
    [2]  -o
    [3]  /mnt/show/seq010/shot0010/images/shot0010_####.png
    [4]  -s
    [5]  3
    [6]  -e
    [7]  3
    [8]  -a
