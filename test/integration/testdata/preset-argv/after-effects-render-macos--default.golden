preset: after-effects-render-macos
case:   default
params:
  Frames=1-20
  FramesPerTask=10
  RenderQueueItem=2
  SceneFile=/Volumes/Show Files/spot/o'brien_v002.aep

step "Render" — 2 tasks

task 1/2  name="Render[Frame=1-10,Frame.End=10,Frame.Start=1]"
  task params:
    Frame=1-10
    Frame.End=10
    Frame.Start=1
  command: /bin/sh
  args:
    [0]  <WORKDIR>
    [1]  -project
    [2]  /Volumes/Show Files/spot/o'brien_v002.aep
    [3]  -rqindex
    [4]  2
    [5]  -s
    [6]  1
    [7]  -e
    [8]  10
    [9]  -v
    [10]  ERRORS_AND_PROGRESS
    [11]  -close
    [12]  DO_NOT_SAVE_CHANGES
  embedded file "aerender_wrapper" (aerender_wrapper.sh):
    dir=
    trap '[ -z "$dir" ] || rm -rf "$dir"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    dir=$(mktemp -d "${TMPDIR:-/tmp}/aerender_wrapper.XXXXXX") || { echo 'aerender_wrapper: cannot create a temporary directory' >&2; exit 1; }
    { aerender "$@" 2>&1; echo "$?" >"$dir/status"; } | tee "$dir/log" || { echo 'aerender_wrapper: tee failed, so the output was not checked' >&2; exit 1; }
    rc=$(cat "$dir/status" 2>/dev/null)
    case $rc in
    0) ;;
    '') echo 'aerender_wrapper: aerender exit status unknown' >&2; exit 1 ;;
    *) exit "$rc" ;;
    esac
    grep -qiF 'aerender ERROR' "$dir/log"
    case $? in
    0) exit 1 ;;
    1) exit 0 ;;
    *) echo 'aerender_wrapper: cannot read the output back' >&2; exit 1 ;;
    esac

task 2/2  name="Render[Frame=11-20,Frame.End=20,Frame.Start=11]"
  task params:
    Frame=11-20
    Frame.End=20
    Frame.Start=11
  command: /bin/sh
  args:
    [0]  <WORKDIR>
    [1]  -project
    [2]  /Volumes/Show Files/spot/o'brien_v002.aep
    [3]  -rqindex
    [4]  2
    [5]  -s
    [6]  11
    [7]  -e
    [8]  20
    [9]  -v
    [10]  ERRORS_AND_PROGRESS
    [11]  -close
    [12]  DO_NOT_SAVE_CHANGES
  embedded file "aerender_wrapper" (aerender_wrapper.sh):
    dir=
    trap '[ -z "$dir" ] || rm -rf "$dir"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    dir=$(mktemp -d "${TMPDIR:-/tmp}/aerender_wrapper.XXXXXX") || { echo 'aerender_wrapper: cannot create a temporary directory' >&2; exit 1; }
    { aerender "$@" 2>&1; echo "$?" >"$dir/status"; } | tee "$dir/log" || { echo 'aerender_wrapper: tee failed, so the output was not checked' >&2; exit 1; }
    rc=$(cat "$dir/status" 2>/dev/null)
    case $rc in
    0) ;;
    '') echo 'aerender_wrapper: aerender exit status unknown' >&2; exit 1 ;;
    *) exit "$rc" ;;
    esac
    grep -qiF 'aerender ERROR' "$dir/log"
    case $? in
    0) exit 1 ;;
    1) exit 0 ;;
    *) echo 'aerender_wrapper: cannot read the output back' >&2; exit 1 ;;
    esac
